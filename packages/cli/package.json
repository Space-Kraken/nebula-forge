{
  "name": "@space-kraken/nebula-forge",
  "version": "0.1.1",
  "description": "forge — an Angular-style CLI for building well-architected, domain-separated AWS solutions",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Space-Kraken/nebula-forge.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Space-Kraken/nebula-forge#readme",
  "bugs": "https://github.com/Space-Kraken/nebula-forge/issues",
  "keywords": ["forge", "nebula-forge", "cli", "aws", "azure", "cdk", "terraform", "scaffolding", "architecture", "iac", "serverless"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "forge": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "oclif": {
    "bin": "forge",
    "dirname": "forge",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "generate": {
        "description": "Generate modules, components and endpoints in the current workspace"
      },
      "remove": {
        "description": "Remove components or endpoints (couplings are detached, files deleted)"
      }
    }
  },
  "dependencies": {
    "@space-kraken/nebula-forge-blueprints": "workspace:^",
    "@space-kraken/nebula-forge-core": "workspace:^",
    "@inquirer/prompts": "^5.3.8",
    "@oclif/core": "^4.0.17"
  },
  "devDependencies": {
    "@space-kraken/nebula-forge-engine-azure-tf": "workspace:^",
    "@space-kraken/nebula-forge-engine-cdk": "workspace:^",
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
